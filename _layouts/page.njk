<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  <meta name="theme-color" content="#f1efe8" />
  <link rel="canonical" href="https://usehopper.vercel.app{{ canonical }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://usehopper.vercel.app{{ canonical }}" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:image" content="https://usehopper.vercel.app/assets/img/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <link rel="icon" href="/assets/img/hopper-mark.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/img/icon-128.png" sizes="128x128" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/img/icon-128.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/styles.css?v=20261026-1" />
  <script>
    document.documentElement.classList.add("js");
    window.addEventListener("error", function () {
      document.documentElement.classList.remove("js");
    });
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header" data-header>
    <div class="shell header-inner">
      <a class="brand" href="/" aria-label="Hopper home">
        <img class="brand-mark" src="/assets/img/hopper-mark.svg" alt="" width="30" height="30" />
        <span>Hopper</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a class="nav-link" href="/download">Download</a>
        <a class="nav-link" href="/privacy"{% if page.url == "/privacy/" %} aria-current="page"{% endif %}>Privacy</a>
        <a class="nav-link" href="/support"{% if page.url == "/support/" %} aria-current="page"{% endif %}>Support</a>
        <a class="nav-link" href="/faq">FAQ</a>
      </nav>
      <div class="header-actions">
        <a class="button button--small" href="/download">Get Hopper</a>
        <button class="nav-toggle" type="button" aria-label="Open menu" aria-controls="mobileNav" aria-expanded="false" data-nav-toggle>
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <dialog class="mobile-nav" id="mobileNav" aria-label="Menu">
    <div class="mobile-nav__inner">
      <div class="mobile-nav__top">
        <a class="brand" href="/">
          <img class="brand-mark" src="/assets/img/hopper-mark.svg" alt="" width="30" height="30" />
          <span>Hopper</span>
        </a>
        <button class="mobile-nav__close" type="button" aria-label="Close menu" data-nav-close>×</button>
      </div>
      <nav class="mobile-nav__links" aria-label="Mobile">
        <a href="/">Home</a>
        <a href="/download">Download</a>
        <a href="/privacy"{% if page.url == "/privacy/" %} aria-current="page"{% endif %}>Privacy</a>
        <a href="/terms"{% if page.url == "/terms/" %} aria-current="page"{% endif %}>Terms</a>
        <a href="/support">Support</a>
        <a href="/faq">FAQ</a>
      </nav>
      <a class="button mobile-nav__cta" href="/download">Get Hopper</a>
    </div>
  </dialog>

  <main id="main">
    <section class="page-hero">
      <div class="shell page-hero__inner">
        <div>
          <span class="kicker">{{ eyebrow }}</span>
          <h1>{{ heading }}</h1>
        </div>
        {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
      </div>
    </section>

    <section class="section section--tight">
      <div class="shell prose legal-body">
        {{ content | safe }}
      </div>
    </section>

    <section class="section section--tight">
      <div class="shell">
        <div class="legal-footer">
          <p>Questions about this page? <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
          <div class="legal-footer__links">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/support">Support</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-brand-col">
        <a class="footer-brand" href="/">
          <img src="/assets/img/hopper-mark.svg" alt="" width="30" height="30" />
          <span>Hopper</span>
        </a>
        <p class="footer-note">Video downloads, conversion, and trimming for Windows and Microsoft Edge. No account, no cloud upload, no analytics.</p>
      </div>
      <div class="footer-col">
        <h3>Product</h3>
        <a href="/download">Download</a>
        <a href="/faq">FAQ</a>
        <a href="/support">Support</a>
      </div>
      <div class="footer-col">
        <h3>Legal</h3>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
      <div class="footer-col">
        <h3>Contact</h3>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>
    </div>
    <div class="shell footer-bottom">
      <span>© {{ site.year }} Hopper</span>
      <span>No cookies. No analytics.</span>
    </div>
  </footer>

  <script src="/assets/app.js?v=20261026-1" defer></script>
</body>
</html>
